# Anthropic API Configuration
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Override default Claude model
# Default: claude-3-sonnet-20240229 (server) / claude-3-7-sonnet-20250219 (client)
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Optional: Maximum tokens for Claude responses
# Default: 1000
ANTHROPIC_MAX_TOKENS=1000

# Optional: Model for fast extraction tasks (city, postal code, etc.)
# Uses Claude Haiku by default for faster, cheaper extraction
# Default: claude-3-haiku-20240307
ANTHROPIC_EXTRACTION_MODEL=claude-3-haiku-20240307

# Optional: Maximum tokens for extraction tasks
# Default: 50 (sufficient for JSON extraction)
ANTHROPIC_EXTRACTION_MAX_TOKENS=50

# Brave Search API Configuration
# Get your API key from https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# Optional: Number of search results to return
# Default: 5
BRAVE_SEARCH_RESULTS_COUNT=5

# OpenWeatherMap API Configuration
# Get your API key from https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Optional: Default country code for weather queries
# Default: fr
OPENWEATHER_DEFAULT_COUNTRY=fr

# Optional: Default language for weather descriptions
# Default: fr
OPENWEATHER_DEFAULT_LANGUAGE=fr
